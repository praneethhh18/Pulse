# ─── Pulse API environment ───────────────────────────────────────────────
# Copy this file to `.env` and fill in values to go LIVE.
# Leave any value blank to run that part in DEMO MODE (in-memory + mock AI).

# MongoDB Atlas connection string. Blank = in-memory store (demo mode).
#   Atlas: create a free M0 cluster, add a DB user, copy the SRV string.
MONGODB_URI=
MONGODB_DB=pulse
# Set to "true" ONLY on a throwaway demo cluster to insert sample data.
# Leave false/blank for any real database.
SEED_DEMO_DATA=false

# Encrypts OAuth tokens at rest (REQUIRED before going live).
# Use a long random string, e.g. `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=

# Google Gemini API key. Blank = deterministic mock AI (demo mode).
#   Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=text-embedding-004

# Server
PORT=4000
# Comma-separated allowed CORS origins for production (blank = allow all, dev only).
# e.g. https://app.pulse.com,https://pulse.com
ALLOWED_ORIGINS=
# Demo user id used when Firebase Auth is not configured (single-user demo).
DEMO_USER_ID=demo-user

# ─── Firebase Auth (real multi-user accounts) ────────────────────────────
# Blank = single-user demo mode (no login required).
# Paste the FULL service-account JSON (one line) from Firebase console →
# Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# ─── Cloud Storage for document media ────────────────────────────────────
# Blank = document photos stored inline (base64 in Mongo, fine for small scale).
# Set a GCS bucket name to store media in Google Cloud Storage (production).
# Auth via Cloud Run service identity or GOOGLE_APPLICATION_CREDENTIALS.
GCS_BUCKET=

# ─── Gmail auto-fetch (the agent watching your inbox) ─────────────────────
# Blank = Gmail integration off (manual entry only).
# Create an OAuth client (type: Web application) in Google Cloud Console,
# add the redirect URI below to it, and paste the credentials here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on your OAuth client.
# Local: http://localhost:4000/gmail/callback
# Deployed: https://your-api-domain/gmail/callback
GOOGLE_OAUTH_REDIRECT=http://localhost:4000/gmail/callback
# How often the backend polls the inbox (seconds).
GMAIL_POLL_SECONDS=120
# How often the backend polls your Google Calendar (seconds).
CALENDAR_POLL_SECONDS=300
